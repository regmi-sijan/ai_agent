# Copy to .env and supply your own Google Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
# Select a tool-calling model available to your API key.
AGENT_MODEL=gemini-2.5-flash
# Optional comma-separated fallback model IDs (empty by default).
AGENT_FALLBACK_MODELS=
MAX_AGENT_STEPS=5
# Minimum spacing between requests; adjust to your account quota.
RATE_LIMIT_DELAY=2.5
